# Copy this file to .env and fill in real values. Never commit .env itself.

RAG_ENV=dev
RAG_LOG_LEVEL=INFO

# ---- Vector DB ----
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_API_KEY=
RAG_COLLECTION=nexora_kb

# ---- Embeddings ----
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- Retrieval ----
RAG_TOP_K_RETRIEVE=30
RAG_TOP_K_FINAL=5

# ---- LLM ----
RAG_LLM_PROVIDER=anthropic
RAG_LLM_MODEL=claude-sonnet-4-6
RAG_ANTHROPIC_API_KEY=
RAG_OPENAI_API_KEY=
RAG_OLLAMA_BASE_URL=http://localhost:11434

# ---- Postgres ----
RAG_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexora
PG_PASSWORD=postgres

# ---- Redis ----
RAG_REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
RAG_JWT_SECRET=change-me-please
RAG_JWT_ALGORITHM=HS256
RAG_JWT_EXPIRES_MINUTES=60

# ---- Observability (optional) ----
RAG_LANGFUSE_PUBLIC_KEY=
RAG_LANGFUSE_SECRET_KEY=
RAG_LANGFUSE_HOST=https://cloud.langfuse.com
