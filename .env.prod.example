# Copy to .env.prod on the EC2 server (never commit .env.prod).
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# --- Domain (must point to the server's Elastic IP; Caddy gets the HTTPS certificate) ---
DOMAIN=nexora.example.com

# --- Image (Amazon ECR). deploy.sh updates IMAGE_TAG by itself ---
IMAGE=<aws-account-id>.dkr.ecr.<region>.amazonaws.com/nexora-rag
IMAGE_TAG=latest
AWS_REGION=<region>

# --- Secrets ---
PG_PASSWORD=change-me
RAG_JWT_SECRET=change-me-long-random-string
GRAFANA_PASSWORD=change-me

# --- Qdrant Cloud ---
RAG_QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
RAG_QDRANT_API_KEY=change-me
RAG_COLLECTION=nexora_kb

# --- LLM ---
RAG_GROQ_API_KEY=change-me
RAG_GROQ_MODEL=openai/gpt-oss-120b

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=change-me
LANGSMITH_PROJECT=nexora-rag

# --- Backups (optional): scripts/backup.sh copies dumps to this S3 bucket ---
S3_BACKUP_BUCKET=
